import { SwissComponent } from '@kibologic/core';

component FeaturesSection {
  _features(): any[] {
    return [
      { icon: '&#9889;', title: 'Real-time Analytics', desc: 'Live data updates every second. Watch your metrics move as events flow in — no manual refresh needed.' },
      { icon: '&#127914;', title: 'Custom Dashboards', desc: 'Drag-and-drop dashboard builder. Arrange charts, tables, and KPI widgets exactly the way your team thinks.' },
      { icon: '&#128101;', title: 'Team Collaboration', desc: 'Share insights across your org. Annotate charts, assign alerts, and keep everyone on the same page.' },
      { icon: '&#128190;', title: 'Data Export', desc: 'Export to CSV, PDF, or push directly to your data warehouse. Scheduled reports delivered to your inbox.' },
      { icon: '&#128276;', title: 'Smart Alerts', desc: 'Get notified when metrics cross thresholds. Route alerts to Slack, email, or any webhook endpoint.' },
      { icon: '&#128279;', title: 'API Access', desc: 'Full REST API for custom integrations. Build your own connectors, embed widgets, or automate reporting.' },
    ];
  }

  render() {
    const features = this._features();
    return (
      <section style="padding:96px 24px;background:#fff;">
        <div style="max-width:1100px;margin:0 auto;">
          <div style="text-align:center;margin-bottom:56px;">
            <h2 style="font-size:36px;font-weight:800;color:#0f172a;margin-bottom:14px;letter-spacing:-1px;">Everything you need to scale</h2>
            <p style="font-size:17px;color:#6b7280;max-width:520px;margin:0 auto;line-height:1.6;">StreamFlow gives you the full analytics stack without the complexity. Set up in minutes, not months.</p>
          </div>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
            {features.map((f: any) => (
              <div key={f.title} style="background:#f8faff;border:1px solid #e0e7ff;border-radius:14px;padding:28px;">
                <div style="width:48px;height:48px;background:#ede9fe;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:16px;">{f.icon}</div>
                <h3 style="font-size:16px;font-weight:700;color:#0f172a;margin-bottom:8px;">{f.title}</h3>
                <p style="font-size:14px;color:#6b7280;line-height:1.65;">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    );
  }
}
