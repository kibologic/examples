import { SwissComponent } from '@kibologic/core';

component TodoApp {
  state {
    let todos: any[] = [];
    let input: string = '';
    let nextId: number = 1;
    let filter: 'all' | 'active' | 'done' = 'all';
  }

  _filtered(): any[] {
    return this.todos.filter((t: any) => {
      if (this.filter === 'active') return !t.done;
      if (this.filter === 'done') return t.done;
      return true;
    });
  }

  _remaining(): number {
    return this.todos.filter((t: any) => !t.done).length;
  }

  mounted() {
    const saved = localStorage.getItem('swissjs-todos');
    if (saved) {
      try { this.todos = JSON.parse(saved); } catch { /* ignore */ }
    }
  }

  _save() {
    localStorage.setItem('swissjs-todos', JSON.stringify(this.todos));
  }

  _addTodo() {
    const text = this.input.trim();
    if (!text) return;
    this.todos = [...this.todos, { id: this.nextId++, text, done: false }];
    this.input = '';
    this._save();
  }

  _toggle(id: number) {
    this.todos = this.todos.map((t: any) => t.id === id ? { ...t, done: !t.done } : t);
    this._save();
  }

  _remove(id: number) {
    this.todos = this.todos.filter((t: any) => t.id !== id);
    this._save();
  }

  render() {
    const filtered = this._filtered();
    const remaining = this._remaining();

    return (
      <div style="max-width:480px;margin:60px auto;padding:0 20px;font-family:monospace;">
        <h1 style="font-size:32px;font-weight:900;color:#111827;margin:0 0 4px;letter-spacing:-0.04em;">
          Todos
          <span style="font-size:14px;font-weight:500;color:#6b7280;margin-left:10px;">{remaining} remaining</span>
        </h1>

        <form
          onsubmit={(e: any) => { e.preventDefault(); this._addTodo(); }}
          style="display:flex;gap:8px;margin:20px 0;"
        >
          <input
            type="text"
            placeholder="What needs to be done?"
            value={this.input}
            oninput={(e: any) => { this.input = e.target.value; }}
            style="flex:1;padding:10px 14px;border:1px solid #d1d5db;border-radius:8px;font:inherit;font-size:14px;"
          />
          <button
            type="submit"
            style="padding:10px 18px;background:#111827;color:#fff;border:none;border-radius:8px;font:inherit;font-weight:700;cursor:pointer;"
          >
            Add
          </button>
        </form>

        <div style="display:flex;gap:8px;margin-bottom:16px;">
          {(['all', 'active', 'done'] as const).map((f: any) => (
            <button
              key={f}
              onclick={() => { this.filter = f; }}
              style={'padding:6px 14px;border-radius:999px;font:inherit;font-size:12px;font-weight:700;cursor:pointer;border:1px solid ' + (this.filter === f ? '#111827' : '#d1d5db') + ';background:' + (this.filter === f ? '#111827' : '#fff') + ';color:' + (this.filter === f ? '#fff' : '#6b7280')}
            >
              {f}
            </button>
          ))}
        </div>

        {filtered.length === 0 && (
          <p style="color:#9ca3af;font-size:14px;text-align:center;padding:32px 0;">
            {this.todos.length === 0 ? 'No todos yet. Add one above.' : 'No todos in this filter.'}
          </p>
        )}

        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:2px;">
          {filtered.map((todo: any) => (
            <li key={String(todo.id)} style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid #f3f4f6;">
              <input
                type="checkbox"
                checked={todo.done}
                onchange={() => this._toggle(todo.id)}
                style="width:16px;height:16px;cursor:pointer;accent-color:#111827;"
              />
              <span style={'flex:1;font-size:14px;' + (todo.done ? 'text-decoration:line-through;color:#9ca3af;' : 'color:#111827;')}>
                {todo.text}
              </span>
              <button
                onclick={() => this._remove(todo.id)}
                style="background:none;border:none;color:#9ca3af;cursor:pointer;font-size:16px;padding:0 4px;"
              >
                ✕
              </button>
            </li>
          ))}
        </ul>
      </div>
    );
  }
}
