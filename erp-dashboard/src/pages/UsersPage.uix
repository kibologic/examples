import { SwissComponent } from '@swissjs/core';
import { DataTable } from '../components/DataTable.uix';
import { StatusBadge } from '../components/StatusBadge.uix';

component UsersPage {
  state { let search: string = ''; }

  render() {
    const allUsers = [
      { id: 1, name: 'James Banda', email: 'j.banda@company.com', role: 'Manager', status: 'active', joined: '2024-01-15' },
      { id: 2, name: 'Sarah Phiri', email: 's.phiri@company.com', role: 'Cashier', status: 'active', joined: '2024-02-20' },
      { id: 3, name: 'Peter Mwale', email: 'p.mwale@company.com', role: 'Storekeeper', status: 'active', joined: '2024-03-10' },
      { id: 4, name: 'Grace Chirwa', email: 'g.chirwa@company.com', role: 'Accountant', status: 'active', joined: '2024-01-08' },
      { id: 5, name: 'John Tembo', email: 'j.tembo@company.com', role: 'Cashier', status: 'inactive', joined: '2023-11-22' },
      { id: 6, name: 'Mary Gondwe', email: 'm.gondwe@company.com', role: 'HR Officer', status: 'active', joined: '2024-04-01' },
      { id: 7, name: 'David Kalua', email: 'd.kalua@company.com', role: 'IT Admin', status: 'active', joined: '2023-09-14' },
      { id: 8, name: 'Rose Lungu', email: 'r.lungu@company.com', role: 'Procurement', status: 'active', joined: '2024-02-05' },
      { id: 9, name: 'Charles Nyirenda', email: 'c.nyirenda@company.com', role: 'Cashier', status: 'pending', joined: '2024-05-12' },
      { id: 10, name: 'Esther Mvula', email: 'e.mvula@company.com', role: 'Manager', status: 'active', joined: '2023-08-30' },
    ];

    const q = this.search.toLowerCase();
    const users = q ? allUsers.filter(u => u.name.toLowerCase().includes(q) || u.email.toLowerCase().includes(q) || u.role.toLowerCase().includes(q)) : allUsers;

    const columns = [
      { key: 'name', label: 'Name' },
      { key: 'email', label: 'Email' },
      { key: 'role', label: 'Role' },
      { key: 'status', label: 'Status' },
      { key: 'joined', label: 'Joined' },
    ];

    return (
      <div>
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
          <h2 style="font-size: 20px; font-weight: 800; color: #e2e8f0; letter-spacing: -0.02em;">Users</h2>
          <button style="background: #4f8ef7; color: #fff; border: none; padding: 9px 18px; border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer;">+ Add User</button>
        </div>
        <div style="margin-bottom: 16px;">
          <input type="text" placeholder="Search users..." value={this.search} oninput={(e: any) => { this.search = e.target.value; this.scheduleUpdate(); }} style="background: #1e1e2e; border: 1px solid #2d2d4e; border-radius: 8px; padding: 9px 14px; font-size: 13px; color: #e2e8f0; width: 300px; outline: none;" />
        </div>
        <div style="background: #1a1a2e; border: 1px solid #2d2d4e; border-radius: 12px; padding: 20px;">
          <DataTable columns={columns} rows={users} />
        </div>
      </div>
    );
  }
}
