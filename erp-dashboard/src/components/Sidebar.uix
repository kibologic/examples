import { SwissComponent } from '@kibologic/core';

component Sidebar {
  render() {
    const { activeRoute } = this.props;
    const navItems = [
      { icon: '⊞', label: 'Dashboard', href: '/dashboard' },
      { icon: '👥', label: 'Users', href: '/users' },
      { icon: '📊', label: 'Reports', href: '/reports' },
      { icon: '⚙', label: 'Settings', href: '/settings' },
    ];
    return (
      <aside style="width: 200px; background: #1e1e2e; height: 100vh; position: fixed; top: 0; left: 0; display: flex; flex-direction: column; border-right: 1px solid #2d2d4e; z-index: 50;">
        <div style="padding: 20px 16px 16px; border-bottom: 1px solid #2d2d4e;">
          <div style="font-size: 18px; font-weight: 900; color: #fff; letter-spacing: -0.04em;">Alpine ERP</div>
          <div style="font-size: 11px; color: #6b7280; margin-top: 2px;">Admin Console</div>
        </div>
        <nav style="flex: 1; padding: 12px 8px; display: flex; flex-direction: column; gap: 2px;">
          {navItems.map(item => (
            <a key={item.href} href={item.href} style={`display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 8px; text-decoration: none; font-size: 13px; font-weight: 600; transition: all 0.15s; background: ${activeRoute === item.href || (activeRoute === '/' && item.href === '/dashboard') ? '#4f8ef7' : 'transparent'}; color: ${activeRoute === item.href || (activeRoute === '/' && item.href === '/dashboard') ? '#fff' : '#9ca3af'};`}>
              <span style="font-size: 14px;">{item.icon}</span>
              {item.label}
            </a>
          ))}
        </nav>
        <div style="padding: 12px 16px; border-top: 1px solid #2d2d4e;">
          <div style="display: flex; align-items: center; gap: 10px;">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #4f8ef7; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: #fff;">SB</div>
            <div>
              <div style="font-size: 12px; font-weight: 700; color: #e2e8f0;">Sarah Banda</div>
              <div style="font-size: 10px; color: #6b7280;">Admin</div>
            </div>
          </div>
        </div>
      </aside>
    );
  }
}
