import { SwissComponent } from '@kibologic/core';

component KpiCard {
  props {
    title: string = '';
    value: string = '';
    change: string = '';
    changeType: string = 'neutral';
  }

  _changeColor() {
    if (this.changeType === 'up') return '#10b981';
    if (this.changeType === 'down') return '#ef4444';
    return '#9ca3af';
  }

  _changeArrow() {
    if (this.changeType === 'up') return '↑';
    if (this.changeType === 'down') return '↓';
    return '→';
  }

  render() {
    const color = this._changeColor();
    const arrow = this._changeArrow();
    return (
      <div style="background:#1a1a2e;border:1px solid #2d2d4e;border-radius:12px;padding:24px;flex:1;min-width:200px;">
        <p style="font-size:13px;color:#9ca3af;margin-bottom:8px;text-transform:uppercase;letter-spacing:0.05em;">{this.title}</p>
        <p style="font-size:28px;font-weight:700;color:#e2e8f0;margin-bottom:8px;">{this.value}</p>
        <p style={`font-size:13px;color:${color};`}>{arrow} {this.change}</p>
      </div>
    );
  }
}
