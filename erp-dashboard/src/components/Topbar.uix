import { SwissComponent } from '@kibologic/core';

component Topbar {
  render() {
    const { title } = this.props;
    return (
      <header style="height: 60px; background: #0f0f23; border-bottom: 1px solid #2d2d4e; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; position: sticky; top: 0; z-index: 40;">
        <h1 style="font-size: 18px; font-weight: 800; color: #e2e8f0; letter-spacing: -0.02em;">{title}</h1>
        <div style="display: flex; align-items: center; gap: 12px;">
          <button style="background: none; border: none; cursor: pointer; color: #6b7280; font-size: 18px; width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; transition: background 0.15s;" onmouseover={(e: any) => e.currentTarget.style.background='#1e1e2e'} onmouseout={(e: any) => e.currentTarget.style.background='none'}>🔔</button>
          <div style="width: 36px; height: 36px; border-radius: 50%; background: #4f8ef7; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: #fff; cursor: pointer;">SB</div>
        </div>
      </header>
    );
  }
}
