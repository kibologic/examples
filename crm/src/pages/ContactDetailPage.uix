import { SwissComponent } from '@swissjs/core';

component ContactDetailPage {
  state { let activeTab: string = 'overview'; }
  state { let noteText: string = ''; }
  state { let notes: any[] = [
    { id: 1, text: 'Discussed Q1 order requirements. Interested in bulk pricing.', time: '3 days ago' },
    { id: 2, text: 'Followed up on pending invoice. Promised payment by end of week.', time: '1 week ago' },
  ]; }

  _getContact(id: string): any {
    const contacts: any[] = [
      { id: '1', name: 'James Banda', company: 'Freshmart Ltd', email: 'j.banda@freshmart.mw', phone: '+265 991 234 567', lastContact: '2 days ago', tags: ['customer', 'vip'], owner: 'Sarah Banda', status: 'active', address: 'Area 3, Lilongwe, Malawi', website: 'freshmart.mw' },
      { id: '2', name: 'Sarah Phiri', company: 'Urban Grocers', email: 's.phiri@urbangrocers.com', phone: '+265 888 345 678', lastContact: '1 week ago', tags: ['prospect'], owner: 'David Kalua', status: 'prospect', address: 'Blantyre CBD, Malawi', website: 'urbangrocers.com' },
    ];
    return contacts.find((c: any) => String(c.id) === String(id)) || { id, name: 'Contact #' + id, company: 'Unknown', email: '-', phone: '-', lastContact: '-', tags: [], owner: 'Unassigned', status: 'unknown', address: '-', website: '-' };
  }

  _initials(name: string): string {
    return name.split(' ').map((w: string) => w[0]).join('').toUpperCase().slice(0, 2);
  }

  _addNote() {
    if (!this.noteText.trim()) return;
    this.notes = [{ id: Date.now(), text: this.noteText.trim(), time: 'Just now' }, ...this.notes];
    this.noteText = '';
    this.scheduleUpdate();
  }

  render() {
    const { contactId } = this.props;
    const contact = this._getContact(contactId || '');
    const initials = this._initials(contact.name);
    const tabs = ['overview', 'deals', 'notes', 'activity'];

    const contactDeals = [
      { id: 1, name: 'Q2 Bulk Order', value: '450,000', stage: 'Proposal', daysInStage: 5 },
      { id: 2, name: 'Annual Supply Agreement', value: '2,100,000', stage: 'Qualified', daysInStage: 12 },
    ];

    const contactActivity = [
      { id: 1, type: 'call', desc: 'Discussed pricing for bulk maize order', time: '2 days ago' },
      { id: 2, type: 'email', desc: 'Sent product catalogue and pricing sheet', time: '1 week ago' },
      { id: 3, type: 'meeting', desc: 'Quarterly review meeting at their office', time: '3 weeks ago' },
    ];

    return (
      <div>
        <div style="margin-bottom: 20px;">
          <a href="/contacts" style="font-size: 13px; color: #2563eb; text-decoration: none; font-weight: 600;">← Back to Contacts</a>
        </div>
        <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 24px; margin-bottom: 20px;">
          <div style="display: flex; align-items: flex-start; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 18px;">
              <div style="width: 60px; height: 60px; border-radius: 50%; background: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800; color: #fff;">{initials}</div>
              <div>
                <h1 style="font-size: 22px; font-weight: 800; color: #111827; letter-spacing: -0.02em;">{contact.name}</h1>
                <div style="font-size: 14px; color: #6b7280; margin-top: 3px;">{contact.company}</div>
                <div style="display: flex; gap: 6px; margin-top: 8px;">
                  {(contact.tags || []).map((tag: string) => (
                    <span key={tag} style="background: #eff6ff; color: #2563eb; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px;">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
            <button style="background: #2563eb; color: #fff; border: none; padding: 9px 18px; border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer;">Edit Contact</button>
          </div>
        </div>
        <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden;">
          <div style="display: flex; border-bottom: 1px solid #e5e7eb;">
            {tabs.map(tab => (
              <button key={tab} onclick={() => { this.activeTab = tab; this.scheduleUpdate(); }} style={`padding: 14px 20px; font-size: 13px; font-weight: 600; border: none; cursor: pointer; text-transform: capitalize; transition: all 0.15s; background: ${this.activeTab === tab ? '#fff' : 'transparent'}; color: ${this.activeTab === tab ? '#2563eb' : '#6b7280'}; border-bottom: ${this.activeTab === tab ? '2px solid #2563eb' : '2px solid transparent'}; margin-bottom: -1px;`}>{tab}</button>
            ))}
          </div>
          <div style="padding: 24px;">
            {this.activeTab === 'overview' ? (
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px;">
                <div>
                  <h3 style="font-size: 14px; font-weight: 700; color: #374151; margin-bottom: 14px;">Contact Info</h3>
                  <div style="display: flex; flex-direction: column; gap: 10px;">
                    <div style="display: flex; gap: 10px;"><span style="font-size: 12px; color: #9ca3af; width: 80px; flex-shrink: 0;">Email</span><span style="font-size: 13px; color: #111827;">{contact.email}</span></div>
                    <div style="display: flex; gap: 10px;"><span style="font-size: 12px; color: #9ca3af; width: 80px; flex-shrink: 0;">Phone</span><span style="font-size: 13px; color: #111827;">{contact.phone}</span></div>
                    <div style="display: flex; gap: 10px;"><span style="font-size: 12px; color: #9ca3af; width: 80px; flex-shrink: 0;">Address</span><span style="font-size: 13px; color: #111827;">{contact.address}</span></div>
                    <div style="display: flex; gap: 10px;"><span style="font-size: 12px; color: #9ca3af; width: 80px; flex-shrink: 0;">Website</span><span style="font-size: 13px; color: #2563eb;">{contact.website}</span></div>
                    <div style="display: flex; gap: 10px;"><span style="font-size: 12px; color: #9ca3af; width: 80px; flex-shrink: 0;">Last Contact</span><span style="font-size: 13px; color: #111827;">{contact.lastContact}</span></div>
                  </div>
                </div>
                <div>
                  <h3 style="font-size: 14px; font-weight: 700; color: #374151; margin-bottom: 14px;">Account Details</h3>
                  <div style="display: flex; flex-direction: column; gap: 10px;">
                    <div style="display: flex; gap: 10px;"><span style="font-size: 12px; color: #9ca3af; width: 80px; flex-shrink: 0;">Company</span><span style="font-size: 13px; color: #111827;">{contact.company}</span></div>
                    <div style="display: flex; gap: 10px;"><span style="font-size: 12px; color: #9ca3af; width: 80px; flex-shrink: 0;">Status</span><span style="font-size: 13px; color: #059669; text-transform: capitalize; font-weight: 600;">{contact.status}</span></div>
                    <div style="display: flex; gap: 10px;"><span style="font-size: 12px; color: #9ca3af; width: 80px; flex-shrink: 0;">Owner</span><span style="font-size: 13px; color: #111827;">{contact.owner}</span></div>
                  </div>
                </div>
              </div>
            ) : null}
            {this.activeTab === 'deals' ? (
              <div>
                <h3 style="font-size: 14px; font-weight: 700; color: #374151; margin-bottom: 14px;">Associated Deals</h3>
                <div style="display: flex; flex-direction: column; gap: 10px;">
                  {contactDeals.map((deal: any) => (
                    <div key={deal.id} style="background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 14px; display: flex; align-items: center; justify-content: space-between;">
                      <div>
                        <div style="font-size: 14px; font-weight: 700; color: #111827;">{deal.name}</div>
                        <div style="font-size: 12px; color: #6b7280; margin-top: 3px;">MWK {deal.value}</div>
                      </div>
                      <span style="font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 20px; background: #eff6ff; color: #2563eb;">{deal.stage}</span>
                    </div>
                  ))}
                </div>
              </div>
            ) : null}
            {this.activeTab === 'notes' ? (
              <div>
                <h3 style="font-size: 14px; font-weight: 700; color: #374151; margin-bottom: 14px;">Notes</h3>
                <div style="margin-bottom: 16px;">
                  <textarea placeholder="Add a note..." value={this.noteText} oninput={(e: any) => { this.noteText = e.target.value; this.scheduleUpdate(); }} style="width: 100%; background: #f9fafb; border: 1px solid #d1d5db; border-radius: 8px; padding: 10px 14px; font-size: 13px; color: #111827; outline: none; resize: vertical; min-height: 80px; font-family: inherit;"></textarea>
                  <button onclick={() => this._addNote()} style="margin-top: 8px; background: #2563eb; color: #fff; border: none; padding: 8px 16px; border-radius: 7px; font-size: 13px; font-weight: 700; cursor: pointer;">Add Note</button>
                </div>
                <div style="display: flex; flex-direction: column; gap: 10px;">
                  {this.notes.map((note: any) => (
                    <div key={note.id} style="background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 14px;">
                      <div style="font-size: 13px; color: #374151; line-height: 1.5; margin-bottom: 6px;">{note.text}</div>
                      <div style="font-size: 11px; color: #9ca3af;">{note.time}</div>
                    </div>
                  ))}
                </div>
              </div>
            ) : null}
            {this.activeTab === 'activity' ? (
              <div>
                <h3 style="font-size: 14px; font-weight: 700; color: #374151; margin-bottom: 14px;">Activity Timeline</h3>
                <div>
                  {contactActivity.map((act: any) => (
                    <div key={act.id} style="display: flex; gap: 14px; padding: 12px 0; border-bottom: 1px solid #f3f4f6;">
                      <div style="width: 32px; height: 32px; border-radius: 50%; background: #eff6ff; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0;">
                        {act.type === 'call' ? '📞' : act.type === 'email' ? '📧' : act.type === 'meeting' ? '📅' : '📝'}
                      </div>
                      <div>
                        <div style="font-size: 13px; color: #374151;">{act.desc}</div>
                        <div style="font-size: 11px; color: #9ca3af; margin-top: 3px;">{act.time}</div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ) : null}
          </div>
        </div>
      </div>
    );
  }
}
