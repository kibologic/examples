import { SwissComponent } from '@swissjs/core';

component DealCard {
  _stageColor(stage: string): string {
    if (stage === 'Won') return '#059669';
    if (stage === 'Lost') return '#dc2626';
    if (stage === 'Proposal') return '#d97706';
    if (stage === 'Qualified') return '#7c3aed';
    return '#2563eb';
  }

  _ownerInitials(owner: string): string {
    return owner.split(' ').map((w: string) => w[0]).join('').toUpperCase().slice(0, 2);
  }

  render() {
    const { name, company, value, owner, daysInStage, stage } = this.props;
    const stageColor = this._stageColor(stage || '');
    const ownerInitials = this._ownerInitials(owner || '');
    return (
      <div style="background: #fff; border: 1px solid #e5e7eb; border-radius: 10px; padding: 14px; cursor: grab; transition: box-shadow 0.15s;" onmouseover={(e: any) => e.currentTarget.style.boxShadow='0 4px 12px rgba(0,0,0,0.08)'} onmouseout={(e: any) => e.currentTarget.style.boxShadow='none'}>
        <div style="font-size: 13px; font-weight: 700; color: #111827; margin-bottom: 4px;">{name}</div>
        <div style="font-size: 12px; color: #6b7280; margin-bottom: 10px;">{company}</div>
        <div style="font-size: 15px; font-weight: 800; color: #111827; margin-bottom: 10px;">MWK {value}</div>
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center; gap: 6px;">
            <div style="width: 24px; height: 24px; border-radius: 50%; background: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; color: #fff;">{ownerInitials}</div>
            <span style="font-size: 11px; color: #9ca3af;">{daysInStage}d in stage</span>
          </div>
          <span style={`font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px; color: ${stageColor}; background: ${stageColor}18;`}>{stage}</span>
        </div>
      </div>
    );
  }
}
