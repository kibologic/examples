import { SwissComponent } from '@swissjs/core';

component ActivityItem {
  _typeIcon(type: string): string {
    if (type === 'call') return '📞';
    if (type === 'email') return '📧';
    if (type === 'meeting') return '📅';
    if (type === 'note') return '📝';
    return '📌';
  }

  _typeColor(type: string): string {
    if (type === 'call') return '#059669';
    if (type === 'email') return '#2563eb';
    if (type === 'meeting') return '#7c3aed';
    if (type === 'note') return '#d97706';
    return '#6b7280';
  }

  render() {
    const { type, description, contact, time } = this.props;
    const icon = this._typeIcon(type || '');
    const color = this._typeColor(type || '');
    return (
      <div style="display: flex; gap: 14px; padding: 14px 0; border-bottom: 1px solid #f3f4f6;">
        <div style={`width: 36px; height: 36px; border-radius: 50%; background: ${color}18; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; margin-top: 2px;`}>{icon}</div>
        <div style="flex: 1; min-width: 0;">
          <div style="font-size: 13px; color: #374151; margin-bottom: 4px;">{description}</div>
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 12px; font-weight: 600; color: #111827;">{contact}</span>
            <span style="font-size: 11px; color: #9ca3af;">{time}</span>
            <span style={`font-size: 11px; font-weight: 600; padding: 1px 7px; border-radius: 20px; color: ${color}; background: ${color}18; text-transform: capitalize;`}>{type}</span>
          </div>
        </div>
      </div>
    );
  }
}
