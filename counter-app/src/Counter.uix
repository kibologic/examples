import { SwissComponent } from '@swissjs/core';

component Counter {
  state {
    let count: number = 0;
    let step: number = 1;
  }

  _doubled(): number {
    return this.count * 2;
  }

  _canDecrement(): boolean {
    return this.count >= this.step;
  }

  mounted() {
    console.log('Counter mounted, initial count:', this.count);
  }

  render() {
    const doubled = this._doubled();
    const canDec = this._canDecrement();

    return (
      <div style="max-width:360px;margin:80px auto;padding:32px;background:#1a1a2e;border:1px solid #2d2d5a;border-radius:16px;font-family:monospace;color:#e8e8f0;text-align:center;">
        <h1 style="margin:0 0 8px;font-size:28px;letter-spacing:-0.04em;">Counter</h1>

        <div style="font-size:72px;font-weight:900;letter-spacing:-0.05em;color:#6c63ff;margin:24px 0;">
          {this.count}
        </div>

        <div style="font-size:14px;color:#8888aa;margin-bottom:24px;">
          doubled: {doubled}
        </div>

        <div style="display:flex;gap:12px;justify-content:center;margin-bottom:24px;">
          <button
            onclick={() => { if (canDec) this.count -= this.step; }}
            disabled={!canDec}
            style={'padding:10px 20px;background:#6c63ff;color:#fff;border:none;border-radius:8px;font:inherit;font-size:16px;cursor:pointer;opacity:' + (canDec ? '1' : '0.4')}
          >
            {'− ' + this.step}
          </button>
          <button
            onclick={() => { this.count = 0; }}
            style="padding:10px 20px;background:#2d2d5a;color:#e8e8f0;border:none;border-radius:8px;font:inherit;font-size:14px;cursor:pointer;"
          >
            Reset
          </button>
          <button
            onclick={() => { this.count += this.step; }}
            style="padding:10px 20px;background:#6c63ff;color:#fff;border:none;border-radius:8px;font:inherit;font-size:16px;cursor:pointer;"
          >
            {'+ ' + this.step}
          </button>
        </div>

        <label style="display:flex;align-items:center;justify-content:center;gap:10px;font-size:13px;color:#8888aa;">
          Step:
          <input
            type="number"
            min="1"
            value={this.step}
            oninput={(e: any) => { this.step = Number(e.target.value) || 1; }}
            style="width:60px;padding:6px 10px;background:#2d2d5a;border:1px solid #4444aa;border-radius:6px;color:#e8e8f0;font:inherit;text-align:center;"
          />
        </label>
      </div>
    );
  }
}
