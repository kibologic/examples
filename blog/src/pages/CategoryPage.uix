import { SwissComponent } from '@kibologic/core';
import { PostCard } from '../components/PostCard.uix';
import { TagBadge } from '../components/TagBadge.uix';

component CategoryPage {
  props {
    category: string = '';
  }

  _allPosts(): any[] {
    return [
      { id: 1, title: 'Building reactive UIs with the SwissJS state system', excerpt: 'A deep dive into how SwissJS handles reactivity under the hood, and why the state block gives you fine-grained control without the overhead of virtual DOM diffing.', author: 'Alex Chen', date: 'May 28, 2026', readTime: '7 min read', category: 'SwissJS', slug: 'reactive-uis-swissjs' },
      { id: 2, title: 'Component patterns in .uix files: a practical guide', excerpt: 'We explore the most effective patterns for organizing components in SwissJS, from simple presentational components to stateful containers with helper methods.', author: 'Maria Santos', date: 'May 25, 2026', readTime: '5 min read', category: 'Tutorial', slug: 'component-patterns-uix' },
      { id: 3, title: 'Why we moved our design system to SwissJS', excerpt: 'After 18 months of fighting with React re-renders and TypeScript generics in JSX, our team made the switch. Here is what we learned and what we would do differently.', author: 'James Wu', date: 'May 22, 2026', readTime: '9 min read', category: 'Architecture', slug: 'design-system-swissjs' },
      { id: 4, title: 'Optimizing render performance in large SwissJS apps', excerpt: 'When your component tree grows to hundreds of nodes, performance matters. We cover memoization strategies, pure components, and when to split state.', author: 'Sophie Turner', date: 'May 19, 2026', readTime: '6 min read', category: 'Performance', slug: 'render-performance' },
      { id: 5, title: 'TypeScript tricks that make your .uix files cleaner', excerpt: 'SwissJS compiles .uix files through the TypeScript compiler. Learn which TypeScript features work best inside components and which to avoid at module level.', author: 'Daniel Park', date: 'May 15, 2026', readTime: '4 min read', category: 'TypeScript', slug: 'typescript-tricks-uix' },
      { id: 6, title: 'Building a full-stack app with SwissJS and Hono', excerpt: 'A step-by-step tutorial for wiring up a SwissJS frontend to a Hono backend, with live reloading and type-safe API calls across the stack.', author: 'Priya Nair', date: 'May 12, 2026', readTime: '12 min read', category: 'Tutorial', slug: 'fullstack-swissjs-hono' },
      { id: 7, title: 'Signal primitives vs state blocks: when to use each', excerpt: 'SwissJS gives you two reactivity primitives. Understanding the difference between a Signal and a state block is key to writing maintainable components.', author: 'Alex Chen', date: 'May 9, 2026', readTime: '5 min read', category: 'SwissJS', slug: 'signals-vs-state' },
      { id: 8, title: 'Micro-frontend architecture with SwissJS', excerpt: 'How to compose multiple independent SwissJS apps into a single shell using module federation and shared routing signals.', author: 'James Wu', date: 'May 6, 2026', readTime: '10 min read', category: 'Architecture', slug: 'micro-frontend-swissjs' },
      { id: 9, title: 'The .uix file format explained for React developers', excerpt: 'Coming from React? This guide maps every React concept — components, props, state, effects — to its SwissJS equivalent so you can get productive fast.', author: 'Maria Santos', date: 'May 3, 2026', readTime: '8 min read', category: 'Tutorial', slug: 'uix-for-react-devs' },
      { id: 10, title: 'Benchmarking SwissJS against Solid and Svelte', excerpt: 'We ran the js-framework-benchmark suite against five frameworks. The results for SwissJS were surprising — especially on update and memory benchmarks.', author: 'Sophie Turner', date: 'Apr 29, 2026', readTime: '11 min read', category: 'Performance', slug: 'benchmarking-swissjs' },
      { id: 11, title: 'Using Zod for runtime validation in SwissJS forms', excerpt: 'Building a robust form validation layer with Zod schemas, integrated directly into SwissJS state blocks and prop definitions.', author: 'Daniel Park', date: 'Apr 25, 2026', readTime: '6 min read', category: 'TypeScript', slug: 'zod-validation-swissjs' },
      { id: 12, title: 'Routing patterns without a router library', excerpt: 'SwissJS has no official router. In this post we build a lightweight SPA router using Signals and the History API — under 50 lines of code.', author: 'Priya Nair', date: 'Apr 21, 2026', readTime: '7 min read', category: 'SwissJS', slug: 'routing-without-library' },
    ];
  }

  _filtered(): any[] {
    const cat = this.category;
    if (!cat) return this._allPosts();
    return this._allPosts().filter((p: any) => p.category.toLowerCase() === cat.toLowerCase());
  }

  _displayName(): string {
    const c = this.category;
    if (!c) return 'All';
    return c.charAt(0).toUpperCase() + c.slice(1);
  }

  render() {
    const posts = this._filtered();
    return (
      <div style="max-width:1100px;margin:0 auto;padding:48px 24px;">
        <div style="margin-bottom:32px;">
          <a href="/" style="color:#2563eb;text-decoration:none;font-size:14px;font-weight:500;">← All posts</a>
        </div>
        <div style="margin-bottom:32px;display:flex;align-items:center;gap:12px;">
          <h1 style="font-size:26px;font-weight:800;color:#111827;">Category:</h1>
          <TagBadge category={this._displayName()} />
        </div>
        <p style="font-size:14px;color:#6b7280;margin-bottom:32px;">{posts.length} article{posts.length === 1 ? '' : 's'}</p>
        {posts.length > 0 ? (
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;">
            {posts.map((p: any) => (
              <a href={'/post/' + p.slug} key={p.id} style="text-decoration:none;display:block;">
                <PostCard id={p.id} title={p.title} excerpt={p.excerpt} author={p.author} date={p.date} readTime={p.readTime} category={p.category} slug={p.slug} />
              </a>
            ))}
          </div>
        ) : (
          <div style="text-align:center;padding:80px 0;color:#9ca3af;font-size:16px;">No posts in this category yet.</div>
        )}
      </div>
    );
  }
}
