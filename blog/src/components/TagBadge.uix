import { SwissComponent } from '@kibologic/core';

component TagBadge {
  props {
    category: string = '';
  }

  _badgeStyle(): string {
    const c = this.category;
    if (c === 'SwissJS') return 'background:#dbeafe;color:#1e40af;font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;display:inline-block;';
    if (c === 'Tutorial') return 'background:#d1fae5;color:#065f46;font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;display:inline-block;';
    if (c === 'Architecture') return 'background:#ede9fe;color:#5b21b6;font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;display:inline-block;';
    if (c === 'Performance') return 'background:#ffedd5;color:#9a3412;font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;display:inline-block;';
    if (c === 'TypeScript') return 'background:#ccfbf1;color:#0f766e;font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;display:inline-block;';
    return 'background:#f3f4f6;color:#374151;font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;display:inline-block;';
  }

  render() {
    return (
      <span style={this._badgeStyle()}>{this.category}</span>
    );
  }
}
